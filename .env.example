# Mira runtime. Copy to .env for local overrides.
# SQLite is the default so the demo boots with zero infrastructure.
# Switch to Postgres when Docker is available:
# DATABASE_URL=postgresql+psycopg://mira:mira@localhost:5432/mira

DATABASE_URL=sqlite:///./data/mira.db
MIRA_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional integrations — adapters stay in demo mode when unset.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
DROPBOX_ACCESS_TOKEN=
ELASTICSEARCH_URL=
VISA_SANDBOX=true
ZENNI_SKILL_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
